    "graph": {
        "CameraInit_1": {
            "nodeType": "CameraInit",
            "version": "12.1",
            "position": [
                0,
                0
            ],
            "inputs": {}
        },
        "ConvertSfMFormat_1": {
            "nodeType": "ConvertSfMFormat",
            "version": "2.0",
            "position": [
                0,
                0
            ],
            "inputs": {
                "input": "{ExportImages_2.outputSfMData}",
                "fileExt": "sfm"
            }
        },
        "DepthMapFilter_1": {
            "nodeType": "DepthMapFilter",
            "version": "4.0",
            "position": [
                0,
                0
            ],
            "inputs": {
                "input": "{DepthMap_1.input}",
                "depthMapsFolder": "{DepthMap_1.output}"
            }
        },
        "DepthMap_1": {
            "nodeType": "DepthMap",
            "version": "5.1",
            "position": [
                0,
                0
            ],
            "inputs": {
                "input": "{IntrinsicsTransforming_2.output}",
                "imagesFolder": "{ExportImages_1.output}"
            }
        },
        "ExportImages_1": {
            "nodeType": "ExportImages",
            "version": "1.1",
            "position": [
                0,
                0
            ],
            "inputs": {
                "input": "{IntrinsicsTransforming_1.input}",
                "target": "{IntrinsicsTransforming_1.output}",
                "masksFolders": [
                    "{ImageSegmentationSam3_1.output}"
                ],
                "outputFileType": "png"
            }
        },
        "ExportImages_2": {
            "nodeType": "ExportImages",
            "version": "1.1",
            "position": [
                0,
                0
            ],
            "inputs": {
                "input": "{IntrinsicsTransforming_1.input}",
                "target": "{IntrinsicsTransforming_1.output}",
                "masksFolders": [
                    "{ImageSegmentationSam3_1.output}"
                ],
                "namingMode": "keep"
            }
        },
        "FeatureExtraction_1": {
            "nodeType": "FeatureExtraction",
            "version": "1.3",
            "position": [
                0,
                0
            ],
            "inputs": {
                "input": "{ImageProcessing_1.outSfMData}",
                "masksFolder": "{ImageSegmentationSam3_1.output}"
            }
        },
        "FeatureMatching_1": {
            "nodeType": "FeatureMatching",
            "version": "2.1",
            "position": [
                0,
                0
            ],
            "inputs": {
                "input": "{ImageMatching_1.input}",
                "featuresFolders": "{ImageMatching_1.featuresFolders}",
                "imagePairsList": "{ImageMatching_1.output}"
            }
        },
        "ImageMatching_1": {
            "nodeType": "ImageMatching",
            "version": "2.1",
            "position": [
                0,
                0
            ],
            "inputs": {
                "input": "{ImageProcessing_1.outSfMData}",
                "featuresFolders": [
                    "{FeatureExtraction_1.output}"
                ]
            }
        },
        "ImageProcessing_1": {
            "nodeType": "ImageProcessing",
            "version": "4.1",
            "position": [
                0,
                0
            ],
            "inputs": {
                "input": "{SfMFilter_1.outputSfMData_selected}",
                "extension": "exr"
            }
        },
        "ImageSegmentationSam3_1": {
            "nodeType": "ImageSegmentationSam3",
            "version": "2.0",
            "position": [
                0,
                0
            ],
            "inputs": {
                "input": "{ImageProcessing_1.outSfMData}",
                "prompt": "bone",
                "extensionOut": "png"
            }
        },
        "IntrinsicsTransforming_1": {
            "nodeType": "IntrinsicsTransforming",
            "version": "1.1",
            "position": [
                0,
                0
            ],
            "inputs": {
                "input": "{SfMTransfer_1.output}"
            }
        },
        "IntrinsicsTransforming_2": {
            "nodeType": "IntrinsicsTransforming",
            "version": "1.1",
            "position": [
                0,
                0
            ],
            "inputs": {
                "input": "{StructureFromMotion_1.output}"
            }
        },
        "LedGetterLights_1": {
            "nodeType": "LedGetterLights",
            "version": "1.0",
            "position": [
                0,
                0
            ],
            "inputs": {
                "inputSfm": "{ConvertSfMFormat_1.output}",
                "downscale": 2,
                "inputMesh": "{MeshFiltering_1.outputMesh}",
                "lightRig": true,
                "excludePoseReferenceImage": true,
                "poseReferencePattern": "all_leds",
                "maskPoseReferenceOnly": true
            }
        },
        "LedGetterPS_1": {
            "nodeType": "LedGetterPS",
            "version": "1.0",
            "position": [
                0,
                0
            ],
            "inputs": {
                "inputSfm": "{ConvertSfMFormat_1.output}",
                "downscale": 2,
                "inputMesh": "{MeshFiltering_1.outputMesh}",
                "inputLights": "{LedGetterLights_1.outputFolder}",
                "excludePoseReferenceImage": true,
                "poseReferencePattern": "all_leds",
                "maskPoseReferenceOnly": true
            }
        },
        "MeshFiltering_1": {
            "nodeType": "MeshFiltering",
            "version": "3.0",
            "position": [
                0,
                0
            ],
            "inputs": {
                "inputMesh": "{Meshing_1.outputMesh}"
            }
        },
        "MeshRemoveUnseenFaces_1": {
            "nodeType": "MeshRemoveUnseenFaces",
            "version": "3.0",
            "position": [
                0,
                0
            ],
            "inputs": {
                "input": "{RNbNeuS2_1.outputAlbedoSfm}",
                "inputMesh": "{RNbNeuS2_1.outputMesh}"
            }
        },
        "Meshing_1": {
            "nodeType": "Meshing",
            "version": "7.0",
            "position": [
                0,
                0
            ],
            "inputs": {
                "input": "{DepthMapFilter_1.input}",
                "depthMapsFolder": "{DepthMapFilter_1.output}"
            }
        },
        "RNbNeuS2_1": {
            "nodeType": "RNbNeuS2",
            "version": "2.2",
            "position": [
                0,
                0
            ],
            "inputs": {
                "inputNormalSfm": "{LedGetterPS_1.outputSfmDataNormal}",
                "inputAlbedoSfm": "{LedGetterPS_1.outputSfmDataAlbedo}",
                "inputMaskFolder": "{LedGetterPS_1.outputMaskFolder}",
                "meshResolution": 512,
                "scalingMode": "silhouettes"
            }
        },
        "SfMFilter_1": {
            "nodeType": "SfMFilter",
            "version": "2.0",
            "position": [
                0,
                0
            ],
            "inputs": {
                "inputFile": "{CameraInit_1.output}",
                "expression": "contains(lower(path), \"all_leds\")"
            }
        },
        "SfMTransfer_1": {
            "nodeType": "SfMTransfer",
            "version": "2.2",
            "position": [
                0,
                0
            ],
            "inputs": {
                "input": "{CameraInit_1.output}",
                "reference": "{StructureFromMotion_1.output}",
                "transferLandmarks": false
            }
        },
        "StructureFromMotion_1": {
            "nodeType": "StructureFromMotion",
            "version": "3.3",
            "position": [
                0,
                0
            ],
            "inputs": {
                "input": "{FeatureMatching_1.input}",
                "featuresFolders": "{FeatureMatching_1.featuresFolders}",
                "matchesFolders": [
                    "{FeatureMatching_1.output}"
                ]
            }
        },
        "Texturing_1": {
            "nodeType": "Texturing",
            "version": "6.0",
            "position": [
                0,
                0
            ],
            "inputs": {
                "input": "{RNbNeuS2_1.outputAlbedoSfm}",
                "imagesFolder": "{RNbNeuS2_1.outputAlbedoFolder}",
                "inputMesh": "{MeshRemoveUnseenFaces_1.outputMesh}",
                "textureSide": 4096,
                "downscale": 1,
                "colorMapping": {
                    "enable": true,
                    "colorMappingFileType": "png"
                },
                "workingColorSpace": "Linear",
                "correctEV": false,
                "visibilityRemappingMethod": "MeshItself",
                "subdivisionTargetRatio": 0.0
            }
        }
    }
}