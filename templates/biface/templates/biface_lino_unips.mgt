    "graph": {
        "CameraInit_1": {
            "nodeType": "CameraInit",
            "version": "12.1",
            "position": [
                0,
                0
            ],
            "inputs": {}
        },
        "ExportImages_1": {
            "nodeType": "ExportImages",
            "version": "1.1",
            "position": [
                0,
                0
            ],
            "inputs": {
                "input": "{IntrinsicsTransforming_1.input}",
                "target": "{IntrinsicsTransforming_1.output}",
                "masksFolders": [
                    "{ImageSegmentationSam3_1.output}"
                ],
                "outputFileType": "png"
            }
        },
        "FeatureExtraction_1": {
            "nodeType": "FeatureExtraction",
            "version": "1.3",
            "position": [
                0,
                0
            ],
            "inputs": {
                "input": "{ImageProcessing_1.outSfMData}",
                "masksFolder": "{ImageSegmentationSam3_1.output}"
            }
        },
        "FeatureExtraction_2": {
            "nodeType": "FeatureExtraction",
            "version": "1.3",
            "position": [
                0,
                0
            ],
            "inputs": {
                "input": "{ImageProcessing_1.outSfMData}",
                "describerTypes": [
                    "tag16h5"
                ]
            }
        },
        "FeatureMatching_1": {
            "nodeType": "FeatureMatching",
            "version": "2.1",
            "position": [
                0,
                0
            ],
            "inputs": {
                "input": "{ImageMatching_1.input}",
                "featuresFolders": "{ImageMatching_1.featuresFolders}",
                "imagePairsList": "{ImageMatching_1.output}",
                "describerTypes": [
                    "dspsift",
                    "tag16h5"
                ]
            }
        },
        "ImageMatching_1": {
            "nodeType": "ImageMatching",
            "version": "2.1",
            "position": [
                0,
                0
            ],
            "inputs": {
                "input": "{ImageProcessing_1.outSfMData}",
                "featuresFolders": [
                    "{FeatureExtraction_1.output}",
                    "{FeatureExtraction_2.output}"
                ]
            }
        },
        "ImageProcessing_1": {
            "nodeType": "ImageProcessing",
            "version": "4.1",
            "position": [
                0,
                0
            ],
            "inputs": {
                "input": "{CameraInit_1.output}",
                "extension": "exr"
            }
        },
        "ImageSegmentationSam3_1": {
            "nodeType": "ImageSegmentationSam3",
            "version": "2.0",
            "position": [
                0,
                0
            ],
            "inputs": {
                "input": "{ImageProcessing_1.outSfMData}",
                "prompt": "stone",
                "extensionOut": "png"
            }
        },
        "IntrinsicsTransforming_1": {
            "nodeType": "IntrinsicsTransforming",
            "version": "1.1",
            "position": [
                0,
                0
            ],
            "inputs": {
                "input": "{StructureFromMotion_1.output}"
            }
        },
        "LINOUniPS_1": {
            "nodeType": "LINOUniPS",
            "version": "2.1",
            "position": [
                0,
                0
            ],
            "inputs": {
                "inputSfm": "{ExportImages_1.outputSfMData}",
                "downscale": 2,
                "nbImages": 10,
                "estimateAlbedo": true,
                "keepLandmarks": false
            }
        },
        "MeshRemoveUnseenFaces_1": {
            "nodeType": "MeshRemoveUnseenFaces",
            "version": "3.0",
            "position": [
                0,
                0
            ],
            "inputs": {
                "input": "{RNbNeuS2_1.outputAlbedoSfm}",
                "inputMesh": "{RNbNeuS2_1.outputMesh}"
            }
        },
        "RNbNeuS2_1": {
            "nodeType": "RNbNeuS2",
            "version": "2.2",
            "position": [
                0,
                0
            ],
            "inputs": {
                "inputNormalSfm": "{LINOUniPS_1.outputSfmDataNormal}",
                "inputAlbedoSfm": "{LINOUniPS_1.outputSfmDataAlbedo}",
                "inputMaskFolder": "{LINOUniPS_1.outputMaskFolder}",
                "meshResolution": 512,
                "scalingMode": "silhouettes"
            }
        },
        "StructureFromMotion_1": {
            "nodeType": "StructureFromMotion",
            "version": "3.3",
            "position": [
                0,
                0
            ],
            "inputs": {
                "input": "{FeatureMatching_1.input}",
                "featuresFolders": "{FeatureMatching_1.featuresFolders}",
                "matchesFolders": [
                    "{FeatureMatching_1.output}"
                ],
                "describerTypes": [
                    "dspsift",
                    "tag16h5"
                ]
            }
        },
        "Texturing_1": {
            "nodeType": "Texturing",
            "version": "6.0",
            "position": [
                0,
                0
            ],
            "inputs": {
                "input": "{RNbNeuS2_1.outputAlbedoSfm}",
                "imagesFolder": "{RNbNeuS2_1.outputAlbedoFolder}",
                "inputMesh": "{MeshRemoveUnseenFaces_1.outputMesh}",
                "textureSide": 4096,
                "downscale": 1,
                "colorMapping": {
                    "enable": true,
                    "colorMappingFileType": "png"
                },
                "workingColorSpace": "Linear",
                "correctEV": false,
                "visibilityRemappingMethod": "MeshItself",
                "subdivisionTargetRatio": 0.0
            }
        }
    }
