                    },
                    "outputColorSpace": {
                        "type": "ChoiceParam",
                        "value": "AUTO",
                        "values": [
                            "AUTO",
                            "sRGB",
                            "rec709",
                            "Linear",
                            "ACES2065-1",
                            "ACEScg",
