                    },
                    "bestScoreThreshold": {
                        "type": "FloatParam",
                        "value": 0.1
                    },
                    "angleHardThreshold": {
                        "type": "FloatParam",
                        "value": 90.0
                    },
                    "workingColorSpace": {
                        "type": "ChoiceParam",
